# HMAC signing secret for paid notice tokens.
NOTICE_SECRET=replace-me-with-a-long-random-string

# Stripe Checkout (optional). If STRIPE_SECRET_KEY is missing or
# does not start with sk_, RaiseNotice uses labeled DEMO PAY that
# still signs a paid token and gates the PDF.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin used in Stripe success/cancel URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
